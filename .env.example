# =====================================================================
# HoneyChain environment configuration
# Copy this file to ".env" (same folder) and fill in the values.
#   PowerShell:  Copy-Item .env.example .env
# .env is git-ignored - never commit it.
# Used by: backend/, blockchain/ and ai-service/
# =====================================================================

NODE_ENV=development
PORT=4000

# ---------- PostgreSQL (authoritative database) ----------
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Use the password you chose when installing PostgreSQL.
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/honeychain

# ---------- MongoDB Community (secondary database) ----------
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=honeychain

# ---------- Security ----------
# Generate a long random value, e.g. in PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=8h
# true only when served over HTTPS
COOKIE_SECURE=false

# ---------- URLs ----------
# Base URL printed inside QR codes. For phone scanning on the same Wi-Fi use your PC's
# LAN IP, e.g. http://192.168.1.20:5173 (and open that port in Windows Firewall).
PUBLIC_BASE_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# Set true to let the backend serve the built frontend (frontend/dist) on port 4000
SERVE_FRONTEND=false

# ---------- AI service (FastAPI) ----------
AI_SERVICE_URL=http://127.0.0.1:8000
# Shared secret between backend and AI service (any long random string)
AI_SERVICE_KEY=CHANGE_ME_TO_ANOTHER_RANDOM_STRING
STANDARDS_PROFILE=FSSAI

# ---------- Blockchain ----------
# hardhat = local development chain (default), sepolia = public testnet for the final demo
CHAIN_NETWORK=hardhat
HARDHAT_RPC_URL=http://127.0.0.1:8545
# Hardhat's built-in TEST account #0. This key is PUBLIC (printed by `npx hardhat node`);
# it only ever holds fake local ETH. NEVER send real funds to it.
HARDHAT_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Sepolia (fill in only for the final demo; see docs/sepolia-setup.md)
SEPOLIA_RPC_URL=
# Private key of a NEW wallet used only for this project, holding only Sepolia test ETH
DEPLOYER_PRIVATE_KEY=
# Optional override; normally read from blockchain/deployments/<network>.json
ANCHOR_CONTRACT_ADDRESS=
ANCHOR_WORKER_ENABLED=true
ANCHOR_WORKER_INTERVAL_MS=5000

# ---------- Anomaly detection ----------
# Isolation Forest runs only when at least this many genuine (non-demo) batches qualify
ANOMALY_MIN_RECORDS=50
# true = also use demo/seed batches (results are labelled "computed on demo data")
ANOMALY_INCLUDE_DEMO=false

# Max login/registration attempts per IP per 15 minutes
LOGIN_RATE_LIMIT=10

# Public page re-checks blockchain integrity if the last check is older than this
# 0 = re-check the blockchain on every QR scan / page refresh (tampering shows immediately)
PUBLIC_REVERIFY_MINUTES=0
